# ═══════════════════════════════════════════════════════════
# ZeroDay Security AI -- Backend Environment Configuration
# Built by ZeroDay Security Services — Vijay Ishan Chowdhury
#
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════════

ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database (SQLite for local dev — switch to Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./zeroday.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/zeroday_db

# Auth — MUST CHANGE in any deployed environment
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── LLM PROVIDER ────────────────────────────────────────────
# Set to one of: nvidia | groq | gemini | ollama | anthropic
LLM_PROVIDER=groq

# ── NVIDIA NIM (Nemotron Ultra / Super — FREE tier) ──────────
# Free API key: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ── GROQ (FREE tier, very fast) ──────────────────────────────
# Free API key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── GOOGLE GEMINI ─────────────────────────────────────────────
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OLLAMA (local, no key needed) ────────────────────────────
# Install: https://ollama.ai | ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── ANTHROPIC CLAUDE (optional) ──────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── CVE Intelligence (optional, increases NVD rate limit) ────
# Free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
